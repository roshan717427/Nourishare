{
  "expo": {
    "name": "Nourishare",
    "slug": "nourishare",
    "version": "1.0.0",
    "scheme": "nourishare",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.roshanpaul.munchable",
      "appleTeamID": "862RFB9H5Y",
      "buildNumber": "22",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Nourishare uses your camera to take photos of meals you log.",
        "NSPhotoLibraryUsageDescription": "Nourishare uses your photo library so you can add meal and profile photos.",
        "CFBundleDisplayName": "Nourishare"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.roshanpaul.nourishare",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Nourishare uses your photos so you can add them to meals and your profile.",
          "cameraPermission": "Nourishare uses your camera to take photos of meals you log.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B6B"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "cdd9ad01-6c90-4a88-9b50-17f53877a548"
      }
    },
    "owner": "roshanpaul"
  }
}
